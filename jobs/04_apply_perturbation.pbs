#!/bin/bash -l
### Stage 04: add the delta onto real ERA5 WPS intermediate files. Each
### ERA5:* file is ~1 GB (1440x721, ~240 records); adjust walltime/YEARS
### below for how many files config.ERA5_IM_DIR actually holds.

#PBS -N lens2pgw_ens10_04_perturb
#PBS -A P66770001
#PBS -l select=1:ncpus=1:mem=50GB
#PBS -l walltime=8:00:00
#PBS -q casper
#PBS -j oe
#PBS -r y


source /glade/work/mingge/miniconda3/etc/profile.d/conda.sh
conda activate casper_2023

cd /glade/u/home/mingge/MPAS/MPAS_LENS2_PGW_ENS10

# Restrict to specific years by editing this, or leave empty for every
# ERA5:* file under config.ERA5_IM_DIR.
YEARS="1984"

# ANNUAL=1 (set via run_pipeline.sh --annual / qsub -v ANNUAL=1) applies the
# single annual-mean delta to every date (writes to
# config.PERTURBED_IM_DIR_ANNUAL instead of config.PERTURBED_IM_DIR). See
# README's "Annual-mean" section.
ANNUAL_FLAG=""
[ "${ANNUAL:-0}" = "1" ] && ANNUAL_FLAG="--annual"

if [ -n "$YEARS" ]; then
    python 04_apply_perturbation.py --years "$YEARS" $ANNUAL_FLAG >& logs/04_apply_perturbation${ANNUAL_FLAG:+_annual}.log
else
    python 04_apply_perturbation.py $ANNUAL_FLAG >& logs/04_apply_perturbation${ANNUAL_FLAG:+_annual}.log
fi
