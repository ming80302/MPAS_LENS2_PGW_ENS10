#!/bin/bash -l
### Stage 01b: average the 10 members' climatologies (stage 01a) into one
### equal-weight ensemble-mean climatology. Cheap -- just reads 10 small
### per-member netCDF files per (period, var, month) and averages them.

#PBS -N lens2pgw_ens10_01b
#PBS -A P66770001
#PBS -l select=1:ncpus=1:mem=50GB
#PBS -l walltime=1:00:00
#PBS -q casper
#PBS -j oe
#PBS -r y

source /glade/work/mingge/miniconda3/etc/profile.d/conda.sh
conda activate casper_2023

cd /glade/u/home/mingge/MPAS/MPAS_LENS2_PGW_ENS10

# ANNUAL=1 (set via run_pipeline.sh --annual / qsub -v ANNUAL=1) switches to
# the single annual-mean ("climate mean") ensemble-mean climatology instead
# of the 12 calendar-month ones -- see README's "Annual-mean" section.
ANNUAL_FLAG=""
[ "${ANNUAL:-0}" = "1" ] && ANNUAL_FLAG="--annual"

python 01b_ensemble_climatology.py --period current $ANNUAL_FLAG >& logs/01b_ensemble_climatology_current${ANNUAL_FLAG:+_annual}.log
python 01b_ensemble_climatology.py --period future  $ANNUAL_FLAG >& logs/01b_ensemble_climatology_future${ANNUAL_FLAG:+_annual}.log
